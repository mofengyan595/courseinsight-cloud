MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=courseinsight
MYSQL_USER=courseinsight
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_PORT=3307
REDIS_PORT=6380
ROCKETMQ_NAMESERVER_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_ANALYSIS_TOPIC=courseinsight-analysis
ROCKETMQ_ANALYSIS_CONSUMER_GROUP=courseinsight-analysis-consumer
ROCKETMQ_ANALYSIS_DLQ_TOPIC=%DLQ%courseinsight-analysis-consumer
ROCKETMQ_ANALYSIS_DLQ_CONSUMER_GROUP=courseinsight-analysis-dlq-consumer
OUTBOX_ENABLED=true
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_INITIAL_DELAY_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_DELAY_SECONDS=30
OUTBOX_RECOVERY_TIMEOUT_SECONDS=300
AI_SERVICE_PORT=8001
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_ISSUER=https://courseinsight.local
JWT_ACCESS_TOKEN_TTL=2h
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=CourseInsight Administrator
SENTIMENT_BACKEND=AUTO
BERT_MODEL_PATH=models/bert_model_final
BERT_DEVICE=AUTO
LLM_API_KEY=replace-with-local-api-key
LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
LLM_MODEL=ecnu-plus
LLM_TIMEOUT=20
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024
LLM_RETRIES=2
